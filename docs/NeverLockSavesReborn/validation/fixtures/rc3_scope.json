      "splices": [
        {
          "candidate_start_line": 0,
          "candidate_end_line": 1,
          "before": "// v1.0.0-rc2 Release Candidate. Deferred/autosave lanes are opt-in.\r\n",
          "after": "// v1.0.0-rc3 Release Candidate. Deferred/autosave lanes are opt-in.\r\n"
        },
        {
          "candidate_start_line": 439,
          "candidate_end_line": 440,
          "before": "  public static func Version() -> String { return \"1.0.0-rc2\"; }\r\n",
          "after": "  public static func Version() -> String { return \"1.0.0-rc3\"; }\r\n"
        },
        {
          "candidate_start_line": 1873,
          "candidate_end_line": 1900,
          "before": "",
          "after": "  // Smart queue admission is independent of permission to force a checkpoint.\r\n  // Called only for a native-locked user request, after quicksave busy guards.\r\n  public static func HandleSmartBlockedSave(game: GameInstance, source: Int32) -> Bool {\r\n    let players: ref<PlayerSystem> = GameInstance.GetPlayerSystem(game);\r\n    if !IsDefined(players) { return false; };\r\n    let player: ref<PlayerPuppet> = players.GetLocalPlayerControlledGameObject() as PlayerPuppet;\r\n    if !IsDefined(player) || player.NLSRebornGetMode() != 3 || player.nlsRebornSafetyBlock || !player.NLSRebornDeferredIntroComplete() { return false; };\r\n    if player.NLSRebornDeferredQueue(source) {\r\n      if player.NLSRebornGetNotificationsEnabled() && !player.NLSRebornGetStatusNotificationsEnabled() {\r\n        if source == 1 {\r\n          PauseMenuGameController.NLSRebornNotify(game, \"Save queued until normal saving is available.\");\r\n        } else {\r\n          PauseMenuGameController.NLSRebornNotify(game, \"Quicksave queued until normal saving is available.\");\r\n        };\r\n      };\r\n      return true;\r\n    };\r\n    // Preserve the existing explicit combat exception when the queue is off.\r\n    if NLSRebornPolicy.AllowForcedCheckpointFallback(game) { return false; };\r\n    if player.NLSRebornGetNotificationsEnabled() {\r\n      let message: String = \"Saving is blocked by the current game state. No save was queued.\";\r\n      if player.NLSRebornGetTone() == 1 { message = \"The game still has the save button hostage. No save queued.\"; };\r\n      if player.NLSRebornGetTone() == 2 { message = \"The game is still blocking this damn save. No save queued.\"; };\r\n      PauseMenuGameController.NLSRebornNotify(game, message);\r\n    };\r\n    return true;\r\n  }\r\n"
        },
        {
          "candidate_start_line": 1970,
          "candidate_end_line": 1971,
          "before": "",
          "after": "    if NLSRebornPolicy.HandleSmartBlockedSave(this.m_gameInstance, 1) { return; };\r\n"
        },
        {
          "candidate_start_line": 2000,
          "candidate_end_line": 2003,
          "before": "",
          "after": "  if GameInstance.IsSavingLocked(this.m_gameInstance, locks) && !this.m_quickSaveInProgress && !this.IsSaveFailedNotificationActive() && !this.IsGameSavedNotificationActive() {\r\n    if NLSRebornPolicy.HandleSmartBlockedSave(this.m_gameInstance, 2) { return; };\r\n  };\r\n"
        },
        {
          "candidate_start_line": 2035,
          "candidate_end_line": 2038,
          "before": "",
          "after": "  if IsDefined(this.GetPlayerControlledObject()) && GameInstance.IsSavingLocked(this.GetPlayerControlledObject().GetGame(), locks) && !this.m_quickSaveInProgress {\r\n    if NLSRebornPolicy.HandleSmartBlockedSave(this.GetPlayerControlledObject().GetGame(), 2) { return; };\r\n  };\r\n"
        }
      ]
